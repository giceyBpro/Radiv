# Déployé dans <racine web>/api/. Toutes les requêtes sous /api/ passent par index.php:
# les URLs restent /api/calculate, /api/config... (aucun .php visible)
# et aucun fichier de ce dossier (lib/, .env...) n'est jamais servi ni exécuté directement.
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^index\.php$ - [L]
RewriteRule ^ index.php [L]
</IfModule>
# Défense en profondeur si mod_rewrite était indisponible: refuse les fichiers de configuration
# et de données. À NE PAS élargir à "tout sauf index.php": ce contrôle d'accès passe avant la
# réécriture ci-dessus et refuserait alors /api/config, /api/calculate...
<FilesMatch "^\.|\.(env|jsonl|log|md|sh)(\.1)?$">
Require all denied
</FilesMatch>
