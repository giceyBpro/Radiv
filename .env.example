# Dépôt git à déployer (HTTPS)
GIT_REPO=https://git.example.org/votre-org/votre-repo.git

# Token git avec droit de lecture du dépôt
GIT_TOKEN=ghp_xxx

# Branche à déployer
GIT_BRANCH=main

# Cibles de déploiement (personnalisables)
# Chemins ~/... acceptés — ne pas mettre de guillemets autour (sinon ~ n'est pas étendu)
BACKEND_DIR=~/[Backend]
FRONTEND_DIR=~/public_html/[Frontend]
CHECKOUT_DIR=~/[Backend]/repo

# Runtime API (personnalisable)
API_PORT=3003
# Origine autorisée pour CORS. Par défaut: SITE_PUBLIC_URL. Mettre * ouvre l'API à tous.
API_CORS_ORIGIN=https://www.example.org
# Proxies autorisés à définir X-Forwarded-For (reverse-proxy local par défaut).
# Valeur vide = l'en-tête est ignoré et l'IP de la socket fait foi.
TRUSTED_PROXIES=127.0.0.1,::1
# Limite de requêtes /api/calculate par IP et par minute
CALCULATE_RATE_LIMIT=60
# Arrondi des durées de restriction (mode local): "round" (défaut, arrondit au jour le plus
# proche — légèrement plus protecteur) ou "floor" (troncature, reproduit exactement les
# valeurs de l'outil SFMN de référence).
RESTRICTION_ROUNDING_MODE=round
# Version PHP (api/) uniquement : stockage du rate-limit par IP et du cache géoIP.
#   auto (défaut) : APCu s'il est disponible, sinon fichiers dans api/var/
#   apcu | file   : force le choix (file est le plus sûr si APCu n'est pas partagé entre processus)
RATE_LIMIT_BACKEND=auto
# Rotation de logs/measurements.jsonl au-delà de cette taille (octets)
LOGS_MAX_BYTES=52428800
# Ce qui est journalisé à chaque calcul (RGPD, minimisation des données) :
#   none : rien n'est écrit
#   user : horodatage + IP + géolocalisation dérivée uniquement (qui/quand)
#   full : défaut, comportement historique — ajoute aussi les données transmises
#          (isotope, débit de dose, taille patient...) et le résultat du calcul
MEASUREMENT_LOGGING_LEVEL=full
# Purge automatique des fichiers de logs plus vieux que N mois. Vide = pas de purge
# (rétention illimitée, défaut).
LOGS_RETENTION_MONTHS=
# Délai d'attente des échanges SMTP (ms)
SMTP_TIMEOUT_MS=15000

# URL finale du site et URL publique API (personnalisables)
SITE_PUBLIC_URL=https://www.example.org
# Nom du site affiché dans les bandeaux / copyright (par défaut: hostname de SITE_PUBLIC_URL)
SITE_NAME=
# Propriétaire du copyright affiché en bas de page (par défaut: SITE_NAME)
COPYRIGHT_OWNER=
API_PUBLIC_URL=https://www.example.org/api
# Active/désactive entièrement le mode "calcul SFMN" (calcul distant, par scraping). À false:
# masqué du sélecteur de mode, absent de /api/config, refusé explicitement par /api/calculate
# et par les exemples des pages d'aide/API — seul le mode "local" reste utilisable.
SFMN_MODE_ENABLED=true
# Mode "calcul sfmn" (fonction spécifique backend)
SFMN_CALCULATOR_URL=https://www.acoramen.net/index.php?option=com_evictionperiod&Itemid=5142&lang=fr
# Activer les traces verbeuses SFMN (requêtes/réponses distantes) pour diagnostic
SFMN_DEBUG=false
# URL de contrôle externe utilisée par monitor_node.sh (curl). Laisser vide pour désactiver ce test.
MONITOR_PUBLIC_CONFIG_URL=https://www.example.org/api/config

# Si true, le script installe automatiquement la tâche cron de supervision
INSTALL_CRON_MONITOR=true

# Backend Node uniquement (la version PHP n'a plus de jeton: la consultation des mesures passe par la
# connexion Google de la page /auth, voir plus bas) : token des endpoints /api/admin/measurements*.
ADMIN_TOKEN=change_me_admin_token
# Coupure de la consultation des mesures collectées. Node: routes /api/admin/* (404 quel que soit le
# jeton). PHP: section « Mesures » de la page /auth.
ADMIN_MEASUREMENTS_ENABLED=true

# Contact + reCAPTCHA
RECAPTCHA_SITE_KEY=6LeXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RECAPTCHA_SECRET_KEY=6LeXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- SMTP (envoi des formulaires de contact) ---
# Serveur SMTP
SMTP_HOST=smtp.example.org
SMTP_PORT=587
# true = SSL/TLS (port 465), false = STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=contact@example.org
SMTP_PASS=mot-de-passe-smtp
# Adresse expéditrice affichée dans les mails
SMTP_FROM=AutoSiteWeb <no-reply@example.org>
# Adresse de destination qui reçoit les messages des visiteurs (jamais exposée)
CONTACT_DEST=admin@example.org

# Alerte email si l'API reste indisponible après redémarrage monitor
ALERT_ON_API_DOWN_EMAIL=false
ALERT_ON_API_DOWN_COOLDOWN_SEC=600

# --- Administration du site (version PHP, api/) : https://<site>/auth ---
# Connexion Google, consultation des mesures, mises à jour. Aucun lien vers /auth sur le site.
# URL de retour à déclarer dans la console Google Cloud (client OAuth « Application Web »):
#   <SITE_PUBLIC_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Adresses Google autorisées, EXACTEMENT celles listées ici (séparées par des virgules ; ni domaine
# entier, ni joker). Validation en 2 étapes recommandée sur ces comptes.
ADMIN_GOOGLE_EMAILS=
# Coupure complète de /auth (404 générique). Elle n'existe de toute façon que si GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET et ADMIN_GOOGLE_EMAILS sont renseignés (et SITE_PUBLIC_URL).
ADMIN_SITE_ENABLED=true
# Mises à jour depuis la page : désactivées par défaut. Même désactivées, la page montre la version installée.
ADMIN_UPDATE_ENABLED=false
# Dépôt à télécharger lors d'une mise à jour : déduit automatiquement de GIT_REPO (en haut de ce fichier)
# par deploy-php.sh et install.php. À renseigner seulement pour viser un autre dépôt (propriétaire/nom).
#UPDATE_GITHUB_REPO=
# Jeton GitHub (lecture seule) que le SITE EN LIGNE peut utiliser pour ses mises à jour. Volontairement
# distinct de GIT_TOKEN : GIT_TOKEN ne sert qu'aux scripts de déploiement et n'est jamais copié sur le
# serveur web. Laissez VIDE pour ne rien conserver sur le serveur : la page /auth demande alors un jeton
# à chaque mise à jour et ne le garde pas. Y mettre la même valeur que GIT_TOKEN évite cette saisie, au
# prix d'un jeton présent dans api/.runtime.env (600, interdit d'accès web).
UPDATE_GITHUB_TOKEN=
