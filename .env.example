# Dépôt git à déployer (HTTPS)
GIT_REPO=https://git.example.org/votre-org/votre-repo.git

# Token git avec droit de lecture du dépôt
GIT_TOKEN=ghp_xxx

# Branche à déployer
GIT_BRANCH=main

# Cibles de déploiement (personnalisables)
BACKEND_DIR=$HOME/[Backend]
FRONTEND_DIR=$HOME/public_html/[Frontend]
CHECKOUT_DIR=$HOME/[Backend]/repo

# Runtime API (personnalisable)
API_PORT=3003
API_CORS_ORIGIN=https://www.example.org

# URL finale du site et URL publique API (personnalisables)
SITE_PUBLIC_URL=https://www.example.org
API_PUBLIC_URL=https://www.example.org/api
# URL de contrôle externe utilisée par monitor_node.sh (curl). Laisser vide pour désactiver ce test.
MONITOR_PUBLIC_CONFIG_URL=https://www.example.org/api/config

# Si true, le script installe automatiquement la tâche cron de supervision
INSTALL_CRON_MONITOR=true

# Token pour accéder aux endpoints/pages admin de collecte (recommandé)
ADMIN_TOKEN=change_me_admin_token

# Contact + reCAPTCHA
RECAPTCHA_SITE_KEY=6LeXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RECAPTCHA_SECRET_KEY=6LeXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- SMTP (envoi des formulaires de contact) ---
# Serveur SMTP
SMTP_HOST=smtp.example.org
SMTP_PORT=587
# true = SSL/TLS (port 465), false = STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=contact@example.org
SMTP_PASS=mot-de-passe-smtp
# Adresse expéditrice affichée dans les mails
SMTP_FROM=AutoSiteWeb <no-reply@example.org>
# Adresse de destination qui reçoit les messages des visiteurs (jamais exposée)
CONTACT_DEST=admin@example.org

# Alerte email si l'API reste indisponible après redémarrage monitor
ALERT_ON_API_DOWN_EMAIL=false
ALERT_ON_API_DOWN_COOLDOWN_SEC=600
