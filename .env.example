# Dépôt git à déployer (HTTPS)
GIT_REPO=https://git.example.org/votre-org/votre-repo.git

# Token git avec droit de lecture du dépôt
GIT_TOKEN=ghp_xxx

# Branche à déployer
GIT_BRANCH=main

# Cibles de déploiement (personnalisables)
# Chemins ~/... acceptés — ne pas mettre de guillemets autour (sinon ~ n'est pas étendu)
BACKEND_DIR=~/[Backend]
FRONTEND_DIR=~/public_html/[Frontend]
CHECKOUT_DIR=~/[Backend]/repo

# Runtime API (personnalisable)
API_PORT=3003
# Origine autorisée pour CORS. Par défaut: SITE_PUBLIC_URL. Mettre * ouvre l'API à tous.
API_CORS_ORIGIN=https://www.example.org
# Proxies autorisés à définir X-Forwarded-For (reverse-proxy local par défaut).
# Valeur vide = l'en-tête est ignoré et l'IP de la socket fait foi.
TRUSTED_PROXIES=127.0.0.1,::1
# Limite de requêtes /api/calculate par IP et par minute
CALCULATE_RATE_LIMIT=60
# Arrondi des durées de restriction (mode local): "round" (défaut, arrondit au jour le plus
# proche — légèrement plus protecteur) ou "floor" (troncature, reproduit exactement les
# valeurs de l'outil SFMN de référence).
RESTRICTION_ROUNDING_MODE=round
# Rotation de logs/measurements.jsonl au-delà de cette taille (octets)
LOGS_MAX_BYTES=52428800
# Délai d'attente des échanges SMTP (ms)
SMTP_TIMEOUT_MS=15000

# URL finale du site et URL publique API (personnalisables)
SITE_PUBLIC_URL=https://www.example.org
# Nom du site affiché dans les bandeaux / copyright (par défaut: hostname de SITE_PUBLIC_URL)
SITE_NAME=
# Propriétaire du copyright affiché en bas de page (par défaut: SITE_NAME)
COPYRIGHT_OWNER=
API_PUBLIC_URL=https://www.example.org/api
# Active/désactive entièrement le mode "calcul SFMN" (calcul distant, par scraping). À false:
# masqué du sélecteur de mode, absent de /api/config, refusé explicitement par /api/calculate
# et par les exemples des pages d'aide/API — seul le mode "local" reste utilisable.
SFMN_MODE_ENABLED=true
# Mode "calcul sfmn" (fonction spécifique backend)
SFMN_CALCULATOR_URL=https://www.acoramen.net/index.php?option=com_evictionperiod&Itemid=5142&lang=fr
# Activer les traces verbeuses SFMN (requêtes/réponses distantes) pour diagnostic
SFMN_DEBUG=false
# URL de contrôle externe utilisée par monitor_node.sh (curl). Laisser vide pour désactiver ce test.
MONITOR_PUBLIC_CONFIG_URL=https://www.example.org/api/config

# Si true, le script installe automatiquement la tâche cron de supervision
INSTALL_CRON_MONITOR=true

# Token pour accéder aux endpoints/pages admin de collecte (recommandé)
ADMIN_TOKEN=change_me_admin_token

# Contact + reCAPTCHA
RECAPTCHA_SITE_KEY=6LeXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RECAPTCHA_SECRET_KEY=6LeXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- SMTP (envoi des formulaires de contact) ---
# Serveur SMTP
SMTP_HOST=smtp.example.org
SMTP_PORT=587
# true = SSL/TLS (port 465), false = STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=contact@example.org
SMTP_PASS=mot-de-passe-smtp
# Adresse expéditrice affichée dans les mails
SMTP_FROM=AutoSiteWeb <no-reply@example.org>
# Adresse de destination qui reçoit les messages des visiteurs (jamais exposée)
CONTACT_DEST=admin@example.org

# Alerte email si l'API reste indisponible après redémarrage monitor
ALERT_ON_API_DOWN_EMAIL=false
ALERT_ON_API_DOWN_COOLDOWN_SEC=600
